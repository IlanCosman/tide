{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(fish --no-execute *)",
      "Bash(fish_indent *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(make fmt)",
      "Bash(make lint)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(git branch -D *)",
      "Bash(git clean -f*)",
      "Bash(git commit --amend*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --delete*)",
      "Bash(git reset --hard*)",
      "Bash(printenv*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)",
      "Read(**/.aws/*)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(**/.config/gcloud/legacy_credentials/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git-credentials)",
      "Read(**/.kube/config)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.ssh/*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/red_team_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
